# Copy to .env and change the values. NEVER commit .env.

# PostgreSQL (admin account; each service gets its own role/database via the init script)
POSTGRES_USER=swiftdrop_admin
POSTGRES_PASSWORD=change_me_admin
POSTGRES_DB=swiftdrop
SERVICE_DB_PASSWORD=change_me_service

# RabbitMQ
RABBITMQ_USER=swiftdrop
RABBITMQ_PASSWORD=change_me_rabbit

# Redis
REDIS_PASSWORD=change_me_redis

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=swiftdrop
MINIO_ROOT_PASSWORD=change_me_minio_min8chars

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# JWT signing secret (shared by identity service and gateway). Use 32+ random characters.
JWT_SECRET=change_me_to_a_long_random_string_32_chars_min

# Notes for the cloud deployment
# - On AWS the database is Amazon RDS: set SPRING_DATASOURCE_URL to the RDS endpoint.
#   The Postgres init script only runs in local compose; on RDS create the per-service
#   databases and logins with OpenTofu/CDK or a Kubernetes Job.
# - Object storage: leave S3_ENDPOINT unset on AWS so the S3 client talks to real S3.
