{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": [
      "angular-eslint"
    ],
    "analytics": "2ff50eae-7ac2-4666-bf29-5dc1d42668ae"
  },
  "newProjectRoot": "projects",
  "projects": {
    "merchant-portal": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/merchant-portal",
      "sourceRoot": "projects/merchant-portal/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/merchant-portal/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/merchant-portal/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/merchant-portal/public"
              }
            ],
            "styles": [
              "node_modules/leaflet/dist/leaflet.css",
              "projects/merchant-portal/src/styles.css"
            ],
            "allowedCommonJsDependencies": [
              "leaflet"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "16kB",
                  "maximumError": "24kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "projects/merchant-portal/src/environments/environment.ts",
                  "with": "projects/merchant-portal/src/environments/environment.production.ts"
                }
              ],
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "merchant-portal:build:production"
            },
            "development": {
              "buildTarget": "merchant-portal:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/merchant-portal/tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/merchant-portal/public"
              }
            ],
            "styles": [
              "node_modules/leaflet/dist/leaflet.css",
              "projects/merchant-portal/src/styles.css"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/merchant-portal/**/*.ts",
              "projects/merchant-portal/**/*.html"
            ],
            "eslintConfig": "projects/merchant-portal/eslint.config.js"
          }
        }
      }
    },
    "admin-console": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/admin-console",
      "sourceRoot": "projects/admin-console/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/admin-console/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/admin-console/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/admin-console/public"
              }
            ],
            "styles": [
              "projects/admin-console/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "16kB",
                  "maximumError": "24kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "projects/admin-console/src/environments/environment.ts",
                  "with": "projects/admin-console/src/environments/environment.production.ts"
                }
              ],
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4202,
            "proxyConfig": "projects/admin-console/proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "admin-console:build:production"
            },
            "development": {
              "buildTarget": "admin-console:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/admin-console/tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/admin-console/public"
              }
            ],
            "styles": [
              "projects/admin-console/src/styles.css"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/admin-console/**/*.ts",
              "projects/admin-console/**/*.html"
            ],
            "eslintConfig": "projects/admin-console/eslint.config.js"
          }
        }
      }
    }
  }
}
