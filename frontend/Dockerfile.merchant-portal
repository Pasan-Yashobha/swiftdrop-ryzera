# Merchant portal image. Build context = this folder (frontend/):
#   docker build -f Dockerfile.merchant-portal -t swiftdrop/merchant-portal frontend
#   docker run -p 4201:8080 -e API_UPSTREAM=http://merchant:8080 swiftdrop/merchant-portal

# ---- Build stage ----
FROM node:22-alpine AS build
WORKDIR /workspace
# Never ask for analytics consent during an image build.
ENV NG_CLI_ANALYTICS=false
# Install dependencies first so code-only changes reuse the cached layer
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY angular.json tsconfig.json ./
COPY projects ./projects
# "production" for real deployments. docker-compose passes "development" so the dev sign-in works before Identity exists.
ARG NG_CONFIGURATION=production
RUN npx ng build merchant-portal --configuration ${NG_CONFIGURATION}

# ---- Runtime stage ----
# The unprivileged nginx image runs as a non-root user and listens on 8080.
FROM nginxinc/nginx-unprivileged:1.27-alpine
# API_UPSTREAM: where /api/ is proxied. DNS_RESOLVER: Docker's embedded DNS; override it elsewhere
# (for example the cluster DNS service in Kubernetes). Only these two variables are substituted into the template.
ENV API_UPSTREAM=http://merchant:8080 \
    DNS_RESOLVER=127.0.0.11 \
    NGINX_ENVSUBST_FILTER='^(API_UPSTREAM|DNS_RESOLVER)$'
COPY nginx/merchant-portal.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /workspace/dist/merchant-portal/browser /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
