<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local Maven settings for the Docker build stage.
  Redirects the Flyway community GitHub Packages registry to Maven Central,
  which avoids the GitHub token auth requirement that breaks the Docker build
  when fetching google-cloud-retail-bom transitively via flyway-core.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0
                              https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>central-mirror</id>
      <name>Redirect to repo1.maven.org</name>
      <url>https://repo1.maven.org/maven2</url>
      <mirrorOf>central,flyway-community-db-support</mirrorOf>
    </mirror>
  </mirrors>
</settings>
